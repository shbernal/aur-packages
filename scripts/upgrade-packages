#!/usr/bin/env bash
# Bump every package with an .nvchecker.toml to its latest upstream version
# (pkgver, pkgrel reset, checksums), in place. Runs as root in an Arch container
# with the repo mounted read-write:
#   docker run --rm -e HOST_UID="$(id -u)" -e GITHUB_TOKEN -v "$PWD:/repo" -w /repo \
#     archlinux:base-devel scripts/upgrade-packages
# The bump itself runs as a user owning the checkout, since makepkg refuses root.
# pkgctl's progress output calls tput unguarded, which fails without a terminal
# (CI, docker without -t), hence the forced TERM.
set -euo pipefail

pacman -Syu --noconfirm --needed devtools nvchecker git >/dev/null

uid=${HOST_UID:-1000}
id builder &>/dev/null || useradd -m -u "$uid" builder

if [[ -n ${GITHUB_TOKEN:-} ]]; then
  install -d -o builder /home/builder/.config/nvchecker
  printf '[keys]\ngithub = "%s"\n' "$GITHUB_TOKEN" > /home/builder/.config/nvchecker/keyfile.toml
  chown builder /home/builder/.config/nvchecker/keyfile.toml
fi

cd packages
mapfile -t packages < <(for f in */.nvchecker.toml; do dirname "$f"; done)
sudo -u builder env TERM=xterm SRCDEST=/tmp BUILDDIR=/tmp \
  pkgctl version upgrade --verbose "${packages[@]}"
