#!/usr/bin/env bash
# Print the packages (dirs under packages/ holding a PKGBUILD) changed between
# two revisions, one per line. With no base, or an all-zero base (first push of
# a branch), print every package.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

base=${1:-}
head=${2:-HEAD}

if [[ -z $base || $base =~ ^0+$ ]]; then
  dirs=$(cd packages && printf "%s\n" */)
else
  dirs=$(git diff --name-only "$base" "$head" -- packages | cut -d/ -f2 -s)
fi

for d in $dirs; do
  d=${d%/}
  if [[ -f packages/$d/PKGBUILD ]]; then echo "$d"; fi
done | sort -u
